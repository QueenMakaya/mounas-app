# ── Airtable: word/activity content (existing, powers /app) ──
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=

# ── Airtable: email captures (newsletter + free e-book) ──
# Table NAME or ID (in the same base as above) with "Email" and "Source" columns.
AIRTABLE_SIGNUPS_TABLE=

# ── WhatsApp (public) ──
# Your number, digits only, international format. Example: 33612345678
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Booking (public) ──
# Your Calendly OR Cal.com link. Examples:
#   https://calendly.com/les-mounas/20min
#   https://cal.com/les-mounas/20min
NEXT_PUBLIC_BOOKING_URL=

# ── Abonnement (Stripe) ──
# Public Payment Link opened by every "Essai gratuit" button (defaults to the live 10 $/mois link).
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
# Server-only restricted key: Customers write, Subscriptions read, Checkout Sessions read, Customer portal write.
STRIPE_SECRET_KEY=

# ── Connexion par code email ──
# Resend API key used to email the 6-digit login codes (unset in dev: the code is printed in the terminal).
RESEND_API_KEY=
# Sender of the login emails, on a domain verified in Resend.
LOGIN_EMAIL_FROM="Les Mounas <contact@lesmounas.school>"
# Random string (32+ characters) signing the login cookies, e.g. `openssl rand -base64 32`.
SESSION_SECRET=
